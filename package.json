{
  "name": "config-store",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo run build:watch",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "all": "turbo run lint typecheck test build",
    "test:unit": "turbo run test:unit",
    "test:unit:file": "turbo run test:unit:file",
    "test:unit:watch": "turbo run test:unit:watch",
    "test:e2e:install": "turbo run test:e2e:install",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "turbo run test:e2e:ui",
    "test:e2e:debug": "turbo run test:e2e:debug",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "checks": "turbo run typecheck lint test:unit",
    "checks:latest": "turbo run typecheck lint test:unit --filter='...[HEAD]'",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "lefthook": "^2.0.13",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
