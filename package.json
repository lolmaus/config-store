{
  "name": "config-store",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo run build:watch",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "all": "turbo run lint typecheck test build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "checks": "turbo run typecheck lint test",
    "checks:latest": "turbo run typecheck lint test --filter='...[HEAD]'",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "lefthook": "^2.0.13",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
