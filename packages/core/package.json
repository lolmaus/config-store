{
  "name": "@config-store/core",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "tsx --tsconfig tsconfig.test.json --test src/**/*.test.ts",
    "test:watch": "tsx --tsconfig tsconfig.test.json --test --watch \"src/**/*.test.ts\""
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@config-store/eslint-config": "workspace:*",
    "@config-store/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "happy-dom": "^20.0.11",
    "tsdown": "^0.18.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "zod": "^4.2.1"
  },
  "dependencies": {
    "zustand": "^5.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
