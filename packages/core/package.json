{
  "name": "@config-store/core",
  "version": "1.0.0-alpha.3",
  "description": "A frontend library to store an arbitrary config (user settings) with strict typing, Zod validation, automated schema migrations, adapters to persist to localStorage or backend",
  "homepage": "https://config-store.lolma.us",
  "bugs": {
    "url": "https://github.com/lolmaus/config-store/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lolmaus/config-store"
  },
  "license": "MIT",
  "author": "Andrey Mikhaylov (lolmaus) <lolmaus@gmail.com> (https://github.com/lolmaus/)",
  "keywords": [
    "typescript",
    "config",
    "settings",
    "migration",
    "migrations",
    "zod"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "build": "tsdown",
    "#comment": "We need `find` below because curly braces expansion is not available on GitHub CI",
    "test:unit": "tsx --tsconfig tsconfig.test.json --test $(find src -name '*.test.ts')",
    "test:unit:file": "tsx --tsconfig tsconfig.test.json --test",
    "test:unit:watch": "tsx --tsconfig tsconfig.test.json --test --watch $(find src -name '*.test.ts')"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@config-store/eslint-config": "workspace:*",
    "@config-store/typescript-config": "workspace:*",
    "@happy-dom/global-registrator": "^20.0.11",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "happy-dom": "^20.0.11",
    "tsdown": "^0.18.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "zod": "^4.2.1"
  },
  "dependencies": {
    "zustand": "^5.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
