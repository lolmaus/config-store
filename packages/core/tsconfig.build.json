{
  "extends": "@config-store/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "composite": false,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts", "src/*.test.ts", "src/**/*.test.tsx", "src/*.test.tsx"]
}
