{
  "name": "@config-store/react",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "#comment": "We need `find` below because curly braces expansion is not available on GitHub CI",
    "test": "tsx --tsconfig tsconfig.test.json --test $(find src -name '*.test.ts' -o -name '*.test.tsx')",
    "test:watch": "tsx --tsconfig tsconfig.test.json --test --watch $(find src -name '*.test.ts' -o -name '*.test.tsx')"
  },
  "peerDependencies": {
    "@config-store/core": "workspace:*",
    "react": ">=18"
  },
  "devDependencies": {
    "@config-store/core": "workspace:*",
    "@config-store/eslint-config": "workspace:*",
    "@config-store/typescript-config": "workspace:*",
    "@happy-dom/global-registrator": "^20.0.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "eslint": "^9.39.1",
    "happy-dom": "^20.0.11",
    "react": "^19.2.0",
    "tsdown": "^0.18.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "zod": "^4.2.1"
  },
  "dependencies": {
    "zustand": "^5.0.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
