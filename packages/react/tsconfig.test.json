{
  "extends": "@config-store/typescript-config/node-test.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.test.tsbuildinfo",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@config-store/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src/**/*.test.ts", "src/*.test.ts", "src/**/*.test.tsx", "src/*.test.tsx"],
  "references": [{"path": "./tsconfig.lib.json"}]
}
